<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only manifest overlay.

    `PetOverlayService` is not exported in the shipped app: only PetMePhone may start the pet.
    But until the onboarding screen (#12) gives the service a real in-app trigger, the only way
    to drive it on a device is `adb shell am start-service`, and that needs an exported service.

    Rather than leave the production manifest open and rely on someone remembering to close it,
    the opening is scoped to the debug variant, where it cannot reach a user. A release build
    keeps `exported="false"` and no override applies.

    Delete this file once #12 lands and the app can start the overlay itself.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service
            android:name="com.gcatcode.petmephone.feature.overlay.service.PetOverlayService"
            android:exported="true"
            tools:node="merge"
            tools:replace="android:exported" />

        <!-- The panel's second launcher icon is invisible on HyperOS, which groups a package's
             launcher activities and shows only the main one, leaving the instrument reachable only
             by adb on that device. This merges a shortcut into the existing launcher activity, so
             a long-press on the app icon offers the panel. Merged rather than declared, because
             `MainActivity` itself lives in the main source set and must not be touched: the
             meta-data and the resource it points at exist only here, in the debug overlay. -->
        <activity
            android:name="com.gcatcode.petmephone.MainActivity"
            tools:node="merge">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts_debug" />
        </activity>

        <!-- Debug-only maintainer instrument (issue #92). A second MAIN/LAUNCHER entry exists
             only in a debug install (`debug-tuning-panel` spec, "A second launcher icon exists on
             a debug install and not on a release install"); this whole element is absent from a
             release manifest merge because the source set it lives in never compiles into one. -->
        <activity
            android:name="com.gcatcode.petmephone.debug.tuning.TuningPanelActivity"
            android:exported="true"
            android:label="@string/tuning_panel_marker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
