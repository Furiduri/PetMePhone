    <!-- Per-step help (#100). Each answers WHY answering changes anything, not what the control
         does — the user can see the control. -->
    <string name="feature_overlay_quickmenu_help_behavior_title">What will you do?</string>
    <string name="feature_overlay_quickmenu_help_behavior_body">Name the action concretely. A vague cue is the most common reason a habit quietly stops — when the moment arrives you have to decide what it meant, and deciding is what you skip on a tired day.</string>
    <string name="feature_overlay_quickmenu_help_behavior_example">Vague: Read.
Concrete: Read one page of the book on my desk.</string>

    <string name="feature_overlay_quickmenu_help_minimum_title">Smallest honest version</string>
    <string name="feature_overlay_quickmenu_help_minimum_body">This is what counts on a bad day. It keeps the chain alive when you have nothing left, and it is worth exactly as much as the full version — no reduced credit, ever. That is the point: on the day you would have skipped, you do the small one instead.</string>
    <string name="feature_overlay_quickmenu_help_minimum_example">Full: Clean the kitchen.
Minimum: Put three dishes in the sink.</string>

    <string name="feature_overlay_quickmenu_help_anchor_title">When will you do it?</string>
    <string name="feature_overlay_quickmenu_help_anchor_body">A habit needs a cue, and a part of the day is a better one than a clock time. A clock arrives whether or not you are in a position to act; a part of the day you recognise arrives already in context. This is also what makes it a habit rather than a task with a date.</string>
    <string name="feature_overlay_quickmenu_help_anchor_example">You can stack a habit onto another habit in the full app.</string>

    <string name="feature_overlay_quickmenu_step_help_back_label">Back to the step</string>

    <!-- Shown when a step cannot be rendered. Makes no promise about the draft in either
         direction, because this content does not know whether one survived. -->
    <string name="feature_overlay_quickmenu_step_unavailable_title">That step is not available</string>
    <string name="feature_overlay_quickmenu_step_unavailable_body">The form could not open where it left off. Nothing was sent.</string>
    <string name="feature_overlay_quickmenu_step_unavailable_leave_label">Back to the dashboard</string>
