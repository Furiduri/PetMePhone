<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One string per CharacterImportRejection case (character-import spec [IMPORT-4]). Each
         formats that case's measured values; no generic catch-all rejection string exists here. -->
    <string name="feature_overlay_import_rejection_not_png">This file is not a PNG image.</string>
    <string name="feature_overlay_import_rejection_too_large">File is %1$d bytes, maximum is %2$d bytes.</string>
    <string name="feature_overlay_import_rejection_oversized">Image is %1$d×%2$d, maximum is %3$d×%3$d.</string>
    <string name="feature_overlay_import_rejection_not_divisible">Image is %1$d×%2$d and does not divide evenly into the declared grid.</string>
    <string name="feature_overlay_import_rejection_undecodable">This image could not be decoded.</string>
    <string name="feature_overlay_import_rejection_empty_sheet">Every frame in this sheet is fully transparent — there is nothing to show.</string>
    <string name="feature_overlay_import_rejection_cap_reached">You already have %1$d characters, the maximum. Delete one to import another.</string>
    <!-- Shown when an imported character has no supplied name — an honest placeholder, never a
         fabricated name (design decision 14). -->
    <string name="feature_overlay_character_unnamed">Unnamed</string>

    <!-- Overlay-permission onboarding (overlay-onboarding-ui spec). Every claim below is checked
         by OverlayOnboardingScreenTest; none may be removed or reworded away from what it states
         without updating that test. Copy is informative, never persuasive — see [ONBOARD-6]. -->
    <string name="feature_overlay_onboarding_claim_what_appears">A small pet will be drawn on top of your other apps.</string>
    <string name="feature_overlay_onboarding_claim_no_access">The app cannot see, read, or interact with the content of other apps, and does not capture your screen.</string>
    <string name="feature_overlay_onboarding_claim_no_data_leaves">No data leaves this device.</string>
    <string name="feature_overlay_onboarding_claim_revocable">You can revoke this permission at any time from system Settings.</string>
    <string name="feature_overlay_onboarding_primary_action">Open Settings</string>
    <string name="feature_overlay_onboarding_primary_action_description">Open system Settings to grant the overlay permission</string>
    <string name="feature_overlay_reentry_card_message">You can turn the pet on later by opening this again.</string>
    <string name="feature_overlay_reentry_card_reopen_description">Open the overlay permission screen again</string>
    <string name="feature_overlay_reentry_card_dismiss_description">Dismiss this reminder</string>

    <!-- Quick-menu card (overlay-quick-menu, overlay-metric-display, quick-menu-text-input
         specs). The card is a container hosting one content at a time (#18): the dashboard below,
         and the task-input content further down. -->
    <string name="feature_overlay_quickmenu_metric_hunger">Hunger</string>
    <string name="feature_overlay_quickmenu_metric_happiness">Happiness</string>
    <string name="feature_overlay_quickmenu_metric_energy">Energy</string>
    <!-- Absence never renders as zero — an explicit label, never a spinner, never 0. -->
    <string name="feature_overlay_quickmenu_metric_unavailable">Not yet available</string>
    <!-- Transient, shown only before the flow's first emission (Hunger only). -->
    <string name="feature_overlay_quickmenu_metric_loading">Loading…</string>
    <string name="feature_overlay_quickmenu_launch_button">Open app</string>
    <string name="feature_overlay_quickmenu_launch_button_description">Open the full app</string>
    <!-- The dashboard's swap trigger into the task-input content. Replaces the former disabled
         "+ Feed" control, which the task-input content now supersedes (#18 Phase 4). -->
    <string name="feature_overlay_quickmenu_add_task_button">+ Add task</string>
    <string name="feature_overlay_quickmenu_add_task_description">Add a task</string>

    <!-- Task-input content (quick-menu-text-input spec). Submission is out of scope for this
         change — #100 owns it; the submit action here calls no task-domain use case. -->
    <!-- Maintainer-decided copy; do not change without a maintainer request. -->
    <string name="feature_overlay_quickmenu_task_input_placeholder">What needs doing?</string>
    <!-- The field's visible label, so the field stays identified once typing hides the
         placeholder. Kept separate from the content description below even though they read the
         same today: one is painted, the other is announced. -->
    <string name="feature_overlay_quickmenu_task_input_field_label">Task title</string>
    <string name="feature_overlay_quickmenu_task_input_field_description">Task title</string>
    <!-- Visible button labels are short; the longer strings below are content descriptions only.
         Painting a description as a label is what squeezed the submit button into a one-letter-wide
         column on a real device. -->
    <string name="feature_overlay_quickmenu_task_input_submit_label">Add</string>
    <string name="feature_overlay_quickmenu_task_input_submit_description">Add this task</string>
    <string name="feature_overlay_quickmenu_task_input_leave_label">Back</string>
    <string name="feature_overlay_quickmenu_task_input_leave_description">Back to the dashboard</string>
    <string name="feature_overlay_quickmenu_task_input_help_label">?</string>
    <string name="feature_overlay_quickmenu_task_input_help_description">How this field works</string>

    <!-- Instructions content (quick-menu-text-input spec). Honest about the current state: the
         field accepts text but creates nothing yet — #100 owns submission. -->
    <string name="feature_overlay_quickmenu_instructions_title">How this field works</string>
    <string name="feature_overlay_quickmenu_instructions_body">Type a short task title, then use Add. Adding does not create a task yet — that is not built. Text you type is discarded when the card closes.</string>
    <string name="feature_overlay_quickmenu_instructions_leave_label">Back</string>
    <string name="feature_overlay_quickmenu_instructions_leave_description">Back to the task input</string>
</resources>
